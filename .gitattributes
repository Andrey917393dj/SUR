/SUR_Message.lua text eol=lf
/SUR_Message.txt text eol=lf
/src/** text eol=lf
/tools/** text eol=lf
/docs/** text eol=lf
/README.md text eol=lf
/requirements-dev.txt text eol=lf
/.gitignore text eol=lf
/.gitattributes text eol=lf
